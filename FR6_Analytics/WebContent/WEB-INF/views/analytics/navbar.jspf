<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<nav class="navbar navbar-expand-lg navbar-dark fr6-navbar mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold text-white d-flex align-items-center" href="${pageContext.request.contextPath}/fr6/analytics/dashboard">
            <span class="badge bg-primary me-2">FR6</span> N Logistic Analytics
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#fr6Nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="fr6Nav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/fr6/analytics/dashboard">
                        Dashboard KPIs
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'sales-trends' ? 'active' : ''}" href="${pageContext.request.contextPath}/fr6/analytics/sales-trends">
                        Sales Trends
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'abc-classification' ? 'active' : ''}" href="${pageContext.request.contextPath}/fr6/analytics/abc-classification">
                        ABC Classification
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'inventory-turnover' ? 'active' : ''}" href="${pageContext.request.contextPath}/fr6/analytics/inventory-turnover">
                        Inventory Turnover
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'profitability' ? 'active' : ''}" href="${pageContext.request.contextPath}/fr6/analytics/profitability">
                        Profitability & P&L
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'demand-forecast' ? 'active' : ''}" href="${pageContext.request.contextPath}/fr6/analytics/demand-forecast">
                        Demand Forecast
                    </a>
                </li>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-secondary">Role: <c:out value="${accessContext.role}"/></span>
                <c:if test="${not empty accessContext.companyId}">
                    <span class="badge bg-info text-dark">Company #${accessContext.companyId}</span>
                </c:if>
                <c:if test="${accessContext.admin or accessContext.seller}">
                    <form method="POST" action="${pageContext.request.contextPath}/fr6/analytics/refresh" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-warning text-white" title="Refresh cached analytics from operational data">
                            &#x21bb; Refresh Cache
                        </button>
                    </form>
                </c:if>
            </div>
        </div>
    </div>
</nav>
